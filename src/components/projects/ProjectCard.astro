---
import { projectTracks, type Project } from "../../data/site";

interface Props {
  project: Project;
  /** Featured cards get a larger heading; the anchor is always `#slug`. */
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const track = projectTracks.find((entry) => entry.id === project.track);
---

<article
  id={project.slug}
  class:list={[
    "group relative flex h-full scroll-mt-28 flex-col overflow-hidden rounded-lg border border-line bg-surface-900 p-6 shadow-lg transition-all duration-300 md:p-8",
    project.featured
      ? "border-brand/25 hover:border-brand/60"
      : "hover:border-brand/50",
    "hover:shadow-[0_0_20px_var(--brand)]/10",
  ]}
>
  <div class="absolute inset-x-0 top-0 h-0.5 bg-linear-to-r from-transparent via-brand to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />

  {
    project.featured && (
      <span class="absolute right-4 top-4 rounded-full border border-brand/35 bg-brand-soft px-2.5 py-1 font-mono text-3xs uppercase tracking-widest text-brand-ink">
        ★ featured
      </span>
    )
  }

  <div class="mb-5 flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-2xs uppercase tracking-widest text-brand-ink">
        <span>[{project.type}]</span>
        <span class="text-ink-faint">·</span>
        <span class="text-ink-faint">{project.year}</span>
        {track && <span class="text-ink-faint">· {track.abbr}</span>}
      </p>
      <h3
        class:list={[
          "font-bold tracking-tight text-ink transition-colors duration-300 group-hover:text-brand-ink",
          featured ? "text-2xl md:text-3xl" : "text-xl md:text-2xl",
        ]}
      >
        {project.title}
      </h3>
    </div>
  </div>

  <p
    class:list={[
      "grow leading-relaxed text-ink-muted",
      featured ? "text-sm md:text-base" : "text-sm",
    ]}
  >
    {project.description}
  </p>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
    <ul class="flex flex-wrap gap-2">
      {
        project.stack.map((tech) => (
          <li class="rounded border border-line bg-surface-600 px-2 py-1 font-mono text-2xs text-ink-muted">
            {tech}
          </li>
        ))
      }
    </ul>

    {
      project.repo ? (
        <a
          href={project.repo}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Open ${project.title} repository on GitHub`}
          class="relative z-10 inline-flex shrink-0 items-center gap-1.5 rounded-md border border-line bg-surface-800 px-2.5 py-1.5 font-mono text-2xs uppercase tracking-widest text-ink-muted transition-colors hover:border-brand/50 hover:text-brand-ink"
        >
          <svg class="size-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"
            />
          </svg>
          repo
        </a>
      ) : (
        <span class="inline-flex shrink-0 items-center gap-1.5 rounded border border-line bg-surface-800 px-2 py-1 font-mono text-2xs text-ink-faint">
          <span class="size-1.5 rounded-full bg-yellow-500" /> local / private
        </span>
      )
    }
  </div>
</article>
