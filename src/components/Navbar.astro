---
import { Image } from "astro:assets";
import avatar from "../assets/image.png";
import ThemeToggle from "./ThemeToggle.astro";
import { navLinks, site } from "../data/site";
---

<nav class="fixed top-0 z-40 w-full">
  <!--
    Soft fading blur under the bar: a gradient panel that is opaque-ish at the
    very top and dissolves to nothing at its lower edge. The blur lives on the
    inner span and is masked by the same gradient, so there is no hard border
    where the effect ends. Mirrors the reference navbar's approach.
  -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[140%] bg-linear-to-b from-surface-950/90 to-transparent"
  >
    <span class="block size-full mask-b-from-80% backdrop-blur-sm"></span>
  </div>

  <div
    class="relative z-10 mx-auto flex max-w-[90%] items-center justify-between px-6 py-4 2xl:max-w-350"
  >
    <a
      href="/"
      class="group flex items-center gap-2.5 text-xl font-bold tracking-tighter text-ink"
    >
      <span
        class="flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full border border-line bg-glass backdrop-blur-sm backdrop-brightness-[1.4] light:backdrop-brightness-100 transition-all duration-300 group-hover:scale-105 group-hover:bg-glass-hover"
      >
        <Image
          src={avatar}
          alt={site.name}
          width={80}
          height={80}
          loading="eager"
          class="size-full object-cover"
        />
      </span>
      <span class="flex items-center">
        <span
          class="font-mono text-brand-ink transition-transform duration-300 group-hover:-translate-x-1"
          >root@</span
        >{site.handle}<span class="text-brand-ink">.</span>
      </span>
    </a>

    <div class="hidden items-center gap-3 md:flex">
      <div
        class="flex items-center gap-2 rounded-full border border-line bg-glass p-1 backdrop-blur-sm backdrop-brightness-[1.4] light:backdrop-brightness-100"
      >
        {
          navLinks.slice(0, 3).map((link, index) => (
            <>
              <a
                href={link.href}
                class="rounded-full bg-transparent px-5 py-2 font-mono text-2xs font-medium uppercase tracking-widest text-ink/60 mix-blend-lighten light:mix-blend-normal transition-all duration-300 hover:bg-glass hover:text-ink"
              >
                {link.label}
              </a>
              {index < 2 && <span class="h-5 w-px bg-glass" />}
            </>
          ))
        }
      </div>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        class="relative z-11 flex size-10 items-center justify-center rounded-full border border-line bg-glass p-1 text-ink/80 backdrop-blur-sm backdrop-brightness-[1.4] light:backdrop-brightness-100 transition-colors hover:text-ink"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <div class="relative size-4">
          <span
            id="nav-icon-open"
          >
            <span
              class="absolute left-0 h-0.5 w-4 bg-current transition-all duration-300 ease-out top-1"
            ></span>
            <span
              class="absolute left-0 h-0.5 w-4 bg-current transition-all duration-300 ease-out top-2"
            ></span>
            <span
              class="absolute left-0 h-0.5 w-4 bg-current transition-all duration-300 ease-out top-3"
            ></span>
          </span>
          <span id="nav-icon-close" class="hidden">
            <span
              class="absolute top-2 left-0 h-0.5 w-4 rotate-45 bg-current transition-all duration-300 ease-out"
            ></span>
            <span
              class="absolute top-2 left-0 h-0.5 w-4 -rotate-45 bg-current transition-all duration-300 ease-out"
            ></span>
          </span>
        </div>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden flex-col items-center gap-1 rounded-b-3xl bg-surface-800/95 px-6 py-4 backdrop-blur-md md:hidden"
  >
    {
      navLinks.slice(0, 3).map((link) => (
        <a
          href={link.href}
          class="w-full rounded-full px-5 py-2.5 text-center font-mono text-xs uppercase tracking-widest text-ink/60 transition-colors hover:bg-glass hover:text-ink"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menu?.classList.toggle("flex", open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => {
    setOpen(menu?.classList.contains("hidden") ?? true);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
