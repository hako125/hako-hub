---
import { navLinks, site } from "../data/site";
---

<nav
  class="fixed top-0 z-40 w-full border-b border-gray-800 bg-surface-800/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-[90%] items-center justify-between px-6 py-4 2xl:max-w-350"
  >
    <a
      href="#home"
      class="group flex items-center gap-2 text-xl font-bold tracking-tighter text-white"
    >
      <span
        class="font-mono text-emerald-500 transition-transform group-hover:-translate-x-1"
        >root@</span
      >{site.handle}<span class="text-emerald-500">.</span>
    </a>

    <div class="hidden items-center gap-10 md:flex">
      {
        navLinks.slice(0, 3).map((link) => (
          <a
            href={link.href}
            class="font-mono text-xs uppercase tracking-widest text-gray-400 transition-colors hover:text-emerald-400"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contacts"
        class="rounded border border-emerald-500/50 px-4 py-2 font-mono text-xs text-emerald-400 transition-all hover:bg-emerald-500/10"
      >
        {navLinks[3].label}
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="text-gray-400 md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <svg
        id="nav-icon-open"
        class="size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="nav-icon-close"
        class="hidden size-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden flex-col items-center space-y-4 border-b border-gray-800 bg-surface-700 px-6 py-6 md:hidden"
  >
    {
      navLinks.map((link, index) =>
        index < 3 ? (
          <a href={link.href} class="font-mono text-gray-400">
            {link.mobile}
          </a>
        ) : (
          <a
            href={link.href}
            class="rounded border border-emerald-500/30 px-4 py-2 font-mono text-emerald-400"
          >
            {link.mobile}
          </a>
        )
      )
    }
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menu?.classList.toggle("flex", open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => {
    setOpen(menu?.classList.contains("hidden") ?? true);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
