---
/**
 * Renders an image as a coloured pixel grid built from block glyphs, then
 * "develops" it: pixels switch on in small batches, and once every pixel is
 * visible the whole grid eases from greyscale to full colour.
 *
 * Pixel data lives in `src/data/avatarPixels.ts`, generated by
 * `scripts/generate-avatar-pixels.mjs` from `src/assets/image.png`.
 *
 * Sizing is fluid: the wrapper carries the source aspect ratio and the grid
 * fills it, so each cell is a perfect square regardless of the monospace font's
 * glyph metrics (block glyph advances vary by font and used to squash the
 * picture). Give the wrapper a max-width and the image scales with it.
 *
 * The grid renders invisible until the parent adds `.is-armed`, so whoever owns
 * the timeline decides when the reveal begins.
 */
import {
  avatarAspect,
  avatarCols,
  avatarLevel,
  avatarPixels,
  avatarRows,
} from "../data/avatarPixels";

interface Props {
  /** Pixels revealed per animation frame. */
  batch?: number;
  /** Delay (ms) between arming and the first pixel. */
  startDelay?: number;
  /** Extra transition time (ms) for the final colour wash. */
  develop?: number;
  class?: string;
}

const {
  batch = 22,
  startDelay = 160,
  develop = 900,
  class: className = "",
} = Astro.props;

const LEVEL = "0123456789abcdefghijklmnopqrstuvwxyz";

const rows: { color: string }[][] = [];
for (let y = 0; y < avatarRows; y++) {
  const row: { color: string }[] = [];
  for (let x = 0; x < avatarCols; x++) {
    const i = (y * avatarCols + x) * 3;
    const r = avatarLevel(LEVEL.indexOf(avatarPixels[i]));
    const g = avatarLevel(LEVEL.indexOf(avatarPixels[i + 1]));
    const b = avatarLevel(LEVEL.indexOf(avatarPixels[i + 2]));
    row.push({ color: `rgb(${r} ${g} ${b})` });
  }
  rows.push(row);
}
---

<div
  class:list={["pixel-avatar", className]}
  data-pixel-avatar
  data-batch={batch}
  data-start-delay={startDelay}
  style={{
    "--develop": `${develop}ms`,
    "--cols": String(avatarCols),
    "--rows": String(avatarRows),
    "--aspect": String(avatarAspect),
  }}
  aria-hidden="true"
>
  {
    rows.map((row) => (
      <div class="pixel-row">
        {row.map((px) => (
          <span class="pixel" data-px style={{ "--px": px.color }} />
        ))}
      </div>
    ))
  }
</div>
