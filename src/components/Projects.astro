---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeader from "./SectionHeader.astro";
import ProjectCard from "./projects/ProjectCard.astro";
import { featuredProjects, projects } from "../data/site";

/**
 * Landing-page teaser: only the headline projects, everything else lives on
 * /projects. The count in the subtitle reflects the full repository so the
 * "view all" link has something concrete to point at.
 */
const shown = featuredProjects.slice(0, 2);
const total = projects.length;
const remaining = total - shown.length;
---

<SectionWrapper id="projects" class="border-t border-line">
  <div
    slot="header"
    class="flex flex-col justify-between gap-8 md:flex-row md:items-end"
  >
    <SectionHeader
      command="Featured Projects"
      subtitle={`// showing ${shown.length} featured of ${total} in the repository`}
    />

    {
      remaining > 0 && (
        <a
          href="/projects"
          class="group inline-flex shrink-0 items-center gap-2 rounded-full border border-line bg-glass px-5 py-2 font-mono text-2xs font-medium uppercase tracking-widest text-ink-muted transition-colors hover:border-brand/50 hover:text-brand-ink"
        >
          all {total} projects
          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>
      )
    }
  </div>

  <div class="mt-4 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
    {shown.map((project) => <ProjectCard project={project} featured />)}
  </div>
</SectionWrapper>
