---
interface Props {
  /** Extra classes on the outer <section> */
  class?: string;
  id?: string;
}

const { class: className = "", id } = Astro.props;
---

<section
  id={id}
  class:list={[
    "reveal mx-auto max-w-[90%] px-6 py-20 2xl:max-w-350",
    className,
  ]}
>
  <slot name="header" />
  <slot />
</section>
