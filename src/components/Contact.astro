---
import SectionWrapper from "./SectionWrapper.astro";
import { site } from "../data/site";
---

<SectionWrapper
  id="contacts"
  class="relative mb-20 border-t border-gray-800/50"
>
  <div slot="header" class="hidden"></div>

  <div class="grid gap-12 md:grid-cols-2">
    <div class="space-y-8">
      <div>
        <h2 class="mb-6 flex items-center gap-3 text-3xl font-bold text-gray-100 md:text-4xl">
          <span class="font-mono text-2xl text-emerald-500">&gt;</span> establish_connection
        </h2>
        <p class="mb-8 max-w-md leading-relaxed text-gray-400">
          Currently based in <span class="text-gray-200">Patna / Bhubaneswar</span>. Open
          to internship opportunities and technical collaborations in Cybersecurity, IoT,
          and AI/ML.
        </p>
      </div>

      <div class="space-y-6 font-mono text-sm">
        <div class="group">
          <p class="mb-1 text-xs uppercase tracking-widest text-emerald-500">
            // Email_Primary
          </p>
          <a
            href={`mailto:${site.email}`}
            class="break-all text-base text-gray-300 transition-colors hover:text-emerald-400"
          >
            {site.email}
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 pt-4 sm:grid-cols-2">
          <div class="group">
            <p class="mb-1 text-xs uppercase tracking-widest text-emerald-500">
              // GitHub_Repo
            </p>
            <a
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-300 transition-colors hover:text-emerald-400"
            >
              {site.githubHandle}
            </a>
          </div>
          <div class="group">
            <p class="mb-1 text-xs uppercase tracking-widest text-emerald-500">
              // LinkedIn_ID
            </p>
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-300 transition-colors hover:text-emerald-400"
            >
              {site.linkedinHandle}
            </a>
          </div>
        </div>
      </div>

      <div
        class="inline-flex items-center gap-3 rounded-md border border-gray-800 bg-surface-600 px-4 py-2"
      >
        <div class="size-2 animate-pulse rounded-full bg-emerald-500"></div>
        <span class="font-mono text-xs uppercase tracking-tighter text-gray-500">
          Current_Node: {site.node}
        </span>
      </div>
    </div>

    <!-- Contact form -->
    <div class="group relative rounded-lg border border-gray-800 bg-surface-900 p-8 shadow-2xl">
      <div
        class="absolute -inset-0.5 rounded-lg bg-linear-to-r from-emerald-500/20 to-blue-500/20 opacity-30 blur transition duration-1000 group-hover:opacity-100"
      >
      </div>

      <form id="contact-form" class="relative z-10 space-y-5" novalidate>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <label
              for="first-name"
              class="font-mono text-3xs uppercase tracking-widest text-emerald-500"
              >First_Name</label
            >
            <input
              type="text"
              id="first-name"
              name="first-name"
              placeholder="John"
              required
              class="w-full rounded border border-gray-800 bg-surface-800 p-3 text-gray-100 transition-colors placeholder:text-gray-800 focus:border-emerald-500/50 focus:outline-none"
            />
          </div>
          <div class="space-y-1">
            <label
              for="last-name"
              class="font-mono text-3xs uppercase tracking-widest text-emerald-500"
              >Last_Name</label
            >
            <input
              type="text"
              id="last-name"
              name="last-name"
              placeholder="Doe"
              required
              class="w-full rounded border border-gray-800 bg-surface-800 p-3 text-gray-100 transition-colors placeholder:text-gray-800 focus:border-emerald-500/50 focus:outline-none"
            />
          </div>
        </div>

        <div class="space-y-1">
          <label
            for="email"
            class="font-mono text-3xs uppercase tracking-widest text-emerald-500"
            >Email_Address</label
          >
          <input
            type="email"
            id="email"
            name="email"
            placeholder="john@example.com"
            required
            class="w-full rounded border border-gray-800 bg-surface-800 p-3 text-gray-100 transition-colors placeholder:text-gray-800 focus:border-emerald-500/50 focus:outline-none"
          />
        </div>

        <div class="space-y-1">
          <label
            for="message"
            class="font-mono text-3xs uppercase tracking-widest text-emerald-500"
            >Message_Payload</label
          >
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Enter your message here..."
            required
            class="w-full resize-none rounded border border-gray-800 bg-surface-800 p-3 text-gray-100 transition-colors placeholder:text-gray-800 focus:border-emerald-500/50 focus:outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="group/btn relative mt-4 w-full overflow-hidden rounded border border-emerald-500/40 bg-emerald-500/5 py-4 font-mono text-xs uppercase tracking-brand-wide text-emerald-400 transition-all duration-500 hover:bg-emerald-500 hover:text-black"
        >
          <span class="relative z-10">Execute_Send()</span>
          <div
            class="absolute inset-0 translate-y-full bg-emerald-500 transition-transform duration-300 group-hover/btn:translate-y-0"
          >
          </div>
        </button>
      </form>
    </div>
  </div>

  <footer
    class="mt-20 flex flex-col items-center justify-between gap-4 border-t border-gray-900 pt-8 font-mono text-3xs uppercase tracking-widest text-gray-600 md:flex-row"
  >
    <p>© {site.year} {site.name}. All rights reserved.</p>
    <div class="flex gap-6">
      <span class="cursor-default text-emerald-500/50 transition-colors hover:text-emerald-500"
        >System.v4.0.0</span
      >
      <span class="text-gray-800">|</span>
      <span>Bhubaneswar, Odisha</span>
    </div>
  </footer>
</SectionWrapper>

<!-- Toast container -->
<div
  id="toast-root"
  class="pointer-events-none fixed bottom-4 right-4 z-50 flex flex-col gap-2"
  aria-live="polite"
></div>

<script>
  type ToastKind = "loading" | "success" | "error";

  const toastRoot = document.getElementById("toast-root");

  const toastStyles: Record<ToastKind, string> = {
    loading: "border-emerald-500 text-emerald-500",
    success: "border-emerald-500 text-emerald-500",
    error: "border-red-500 text-red-500",
  };

  const showToast = (message: string, kind: ToastKind): HTMLElement | null => {
    if (!toastRoot) return null;
    const el = document.createElement("div");
    el.className = `pointer-events-auto rounded-md border bg-surface-800 px-4 py-3 font-mono text-xs transition-opacity duration-200 ${toastStyles[kind]}`;
    el.textContent = message;
    toastRoot.appendChild(el);
    return el;
  };

  const dismiss = (el: HTMLElement | null) => {
    if (!el) return;
    el.style.opacity = "0";
    setTimeout(() => el.remove(), 220);
  };

  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const payload = {
      firstName: String(data.get("first-name") ?? "").trim(),
      lastName: String(data.get("last-name") ?? "").trim(),
      email: String(data.get("email") ?? "").trim(),
      message: String(data.get("message") ?? "").trim(),
    };

    if (!payload.firstName || !payload.email || !payload.message) {
      const warn = showToast("Transmission Failed: missing required fields.", "error");
      setTimeout(() => dismiss(warn), 3500);
      return;
    }

    const pending = showToast("Initiating secure transmission...", "loading");

    try {
      // Replace with your own endpoint (e.g. Formspree / EmailJS / serverless function).
      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(`status ${response.status}`);
      } else {
        // Demo mode: simulate a successful transmission.
        await new Promise((resolve) => setTimeout(resolve, 900));
      }

      dismiss(pending);
      const ok = showToast("System: Transmission Successful.", "success");
      setTimeout(() => dismiss(ok), 4000);
      form.reset();
    } catch (error) {
      dismiss(pending);
      const message =
        error instanceof Error ? error.message : "Check connection.";
      const fail = showToast(`Transmission Failed: ${message}`, "error");
      setTimeout(() => dismiss(fail), 4000);
    }
  });
</script>
