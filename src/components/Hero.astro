---
import { heroTags, site, terminalBoot } from "../data/site";
import PixelAvatar from "./PixelAvatar.astro";
---

<section
  id="home"
  class="mx-auto flex min-h-[85vh] max-w-[90%] flex-col items-center justify-between bg-transparent px-6 py-20 text-ink md:flex-row 2xl:max-w-350"
>
  <div class="z-10 w-full flex-1 space-y-8 md:pr-12">
    <div class="space-y-2">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand/30 bg-brand-soft px-3 py-1"
      >
        <span class="size-2 animate-pulse rounded-full bg-brand"></span>
        <p class="font-mono text-xs uppercase tracking-widest text-brand-ink">
          System.Status: Online
        </p>
      </div>
      <h1
        class="bg-linear-to-r from-ink to-ink-muted bg-clip-text pb-2 text-6xl font-bold tracking-tighter text-transparent md:text-8xl"
      >
        {site.name}
      </h1>
      <h2 class="mt-2 font-mono text-2xl font-medium text-ink-muted md:text-3xl">
        {site.tagline}
      </h2>
    </div>

    <div class="flex flex-wrap gap-3">
      {
        heroTags.map((tag) => (
          <div
            class:list={["border px-4 py-2 font-mono text-sm", tag.className]}
          >
            {tag.label}
          </div>
        ))
      }
    </div>

    <p
      class="max-w-lg border-l-2 border-line-strong pl-4 font-mono text-sm text-ink-muted"
    >
      &gt; Executing hardware-level optimizations &amp; building
      attack-resistant systems.
    </p>

  </div>

  <div class="group relative z-10 mt-16 w-full flex-1 md:mt-0">
    <div
      class="absolute -inset-1 rounded-lg bg-linear-to-r from-brand to-brand-ink opacity-20 blur transition duration-1000 group-hover:opacity-40 group-hover:duration-200"
    >
    </div>
    <div
      class="relative flex min-h-105 flex-col overflow-hidden rounded-lg border border-line bg-surface-900 shadow-2xl"
    >
      <div
        class="flex items-center justify-between border-b border-line bg-surface-600 px-4 py-3"
      >
        <div class="flex gap-2">
          <div class="size-3 rounded-full bg-red-500/80"></div>
          <div class="size-3 rounded-full bg-yellow-500/80"></div>
          <div class="size-3 rounded-full bg-green-500/80"></div>
        </div>
        <span class="font-mono text-xs text-ink-muted">root@hako: ~</span>
        <div class="flex gap-1">
          <span class="h-3 w-1 animate-pulse bg-brand"></span>
          <span class="h-3 w-1 animate-pulse bg-brand delay-75"></span>
          <span class="h-3 w-1 animate-pulse bg-brand delay-150"></span>
        </div>
      </div>
      <div class="relative grow overflow-hidden p-6">
        <div
          class="pointer-events-none absolute inset-0 z-20 bg-size-[100%_4px]"
        >
        </div>
        <div class="relative z-10 font-mono text-sm leading-relaxed text-brand-ink md:text-base">
          <div class="term-log">
            <span id="terminal-log" data-source={terminalBoot} aria-live="polite"></span>
          </div>
        </div>
        <div
          id="terminal-avatar"
          class="terminal-avatar pointer-events-none absolute inset-0 grid place-items-center p-6 opacity-0 transition-opacity duration-500 ease-out"
        >
          <PixelAvatar />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const log = document.getElementById("terminal-log");
  const avatarStage = document.getElementById("terminal-avatar");
  const avatar = avatarStage?.querySelector<HTMLElement>("[data-pixel-avatar]");
  const source = log?.dataset.source ?? "";
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const TYPE_SPEED = 25; // ms per character

  /** Resolve after `ms`, cancelled if the signal aborts. */
  const wait = (ms: number, signal: AbortSignal) =>
    new Promise<void>((resolve) => {
      const id = window.setTimeout(resolve, ms);
      signal.addEventListener("abort", () => {
        window.clearTimeout(id);
        resolve();
      });
    });

  /**
   * Reveals the avatar's pixels in batches, then lets the grid develop into
   * full colour. Falls back to showing everything when motion is reduced.
   */
  const playAvatar = (el: HTMLElement, signal: AbortSignal) => {
    const pixels = Array.from(el.querySelectorAll<HTMLElement>("[data-px]"));
    const batch = Number(el.dataset.batch) || 8;
    const startDelay = Number(el.dataset.startDelay) || 0;

    // Show every colour (inherited from inline style) once revealed.
    for (const px of pixels) px.style.visibility = "hidden";

    if (reduced) {
      for (const px of pixels) px.style.visibility = "visible";
      el.classList.add("is-armed", "is-developed");
      return;
    }

    el.classList.add("is-armed");

    let index = 0;
    let raf = 0;

    const step = () => {
      if (signal.aborted) return;
      const end = Math.min(index + batch, pixels.length);
      for (; index < end; index += 1) pixels[index].style.visibility = "visible";

      if (index < pixels.length) {
        raf = requestAnimationFrame(step);
      } else {
        // Last pixel landed — wash the greyscale overlay away.
        el.classList.add("is-developed");
      }
    };

    window.setTimeout(() => {
      if (!signal.aborted) raf = requestAnimationFrame(step);
    }, startDelay);

    signal.addEventListener("abort", () => cancelAnimationFrame(raf));
  };

  const controller = new AbortController();
  const { signal } = controller;
  window.addEventListener("pagehide", () => controller.abort(), { once: true });

  const hide = (el: HTMLElement | null) => {
    if (!el) return;
    el.classList.add("opacity-0", "pointer-events-none");
  };

  const reveal = (el: HTMLElement | null) => {
    if (!el) return;
    el.classList.remove("opacity-0", "pointer-events-none");
  };

  const run = async () => {
    if (!log) return;

    // 1. Boot log types out character by character.
    if (reduced) {
      log.textContent = source;
    } else {
      for (let i = 1; i <= source.length; i += 1) {
        if (signal.aborted) return;
        log.textContent = source.slice(0, i);
        await wait(TYPE_SPEED, signal);
      }
    }

    if (signal.aborted) return;

    if (reduced) {
      // No theatre: keep the log, show the avatar beneath it.
      if (avatar) playAvatar(avatar, signal);
      return;
    }

    // 2. Hold the finished log on screen so it can be read.
    await wait(900, signal);
    if (signal.aborted) return;

    // 3. Wipe the log away.
    log.classList.add("term-log--out");
    await wait(450, signal);
    if (signal.aborted) return;

    hide(log);

    // 4. Swap in the pixel avatar and develop it.
    reveal(avatarStage);
    if (avatar) playAvatar(avatar, signal);
  };

  void run();
</script>
