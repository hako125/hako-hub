---
import { heroTags, site, terminalBoot } from "../data/site";
---

<section
  id="home"
  class="mx-auto flex min-h-[85vh] max-w-[90%] flex-col items-center justify-between bg-transparent px-6 py-20 text-white md:flex-row 2xl:max-w-350"
>
  <div class="z-10 w-full flex-1 space-y-8 md:pr-12">
    <div class="space-y-2">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1"
      >
        <span class="size-2 animate-pulse rounded-full bg-emerald-500"></span>
        <p class="font-mono text-xs uppercase tracking-widest text-emerald-400">
          System.Status: Online
        </p>
      </div>
      <h1
        class="bg-linear-to-r from-white to-gray-500 bg-clip-text pb-2 text-6xl font-bold tracking-tighter text-transparent md:text-8xl"
      >
        {site.name}
      </h1>
      <h2 class="mt-2 font-mono text-2xl font-medium text-gray-400 md:text-3xl">
        {site.tagline}
      </h2>
    </div>

    <div class="flex flex-wrap gap-3">
      {
        heroTags.map((tag) => (
          <div
            class:list={["border px-4 py-2 font-mono text-sm", tag.className]}
          >
            {tag.label}
          </div>
        ))
      }
    </div>

    <p
      class="max-w-lg border-l-2 border-gray-700 pl-4 font-mono text-sm text-gray-500"
    >
      &gt; Executing hardware-level optimizations &amp; building
      attack-resistant systems.
    </p>

    <div class="flex flex-wrap gap-4 pt-4">
      <a
        href="#contacts"
        class="rounded-md border border-emerald-500/50 bg-emerald-500/10 px-8 py-4 font-mono text-sm text-emerald-400 shadow-[0_0_15px_var(--color-emerald-500)]/15 transition-all duration-300 hover:bg-emerald-500 hover:text-white hover:shadow-[0_0_25px_var(--color-emerald-500)]/40"
      >
        init_contact()
      </a>
      <a
        href={site.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-md border border-gray-700 bg-surface-500/50 px-8 py-4 font-mono text-sm text-gray-300 backdrop-blur-sm transition-all duration-300 hover:border-emerald-500 hover:text-emerald-400"
      >
        view_resume<span class="text-emerald-500 transition-colors group-hover:text-white"
          >.pdf</span
        >
      </a>
    </div>
  </div>

  <div class="group relative z-10 mt-16 w-full flex-1 md:mt-0">
    <div
      class="absolute -inset-1 rounded-lg bg-linear-to-r from-emerald-600 to-blue-600 opacity-20 blur transition duration-1000 group-hover:opacity-40 group-hover:duration-200"
    >
    </div>
    <div
      class="relative flex min-h-105 flex-col overflow-hidden rounded-lg border border-gray-800 bg-surface-900 shadow-2xl"
    >
      <div
        class="flex items-center justify-between border-b border-gray-800 bg-surface-600 px-4 py-3"
      >
        <div class="flex gap-2">
          <div class="size-3 rounded-full bg-red-500/80"></div>
          <div class="size-3 rounded-full bg-yellow-500/80"></div>
          <div class="size-3 rounded-full bg-green-500/80"></div>
        </div>
        <span class="font-mono text-xs text-gray-500">root@aditya-dev: ~</span>
        <div class="flex gap-1">
          <span class="h-3 w-1 animate-pulse bg-emerald-500"></span>
          <span class="h-3 w-1 animate-pulse bg-emerald-500 delay-75"></span>
          <span class="h-3 w-1 animate-pulse bg-emerald-500 delay-150"></span>
        </div>
      </div>
      <div
        class="relative grow whitespace-pre-wrap p-6 font-mono text-sm leading-relaxed text-emerald-400 md:text-base"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-linear-[transparent_50%,rgba(0,0,0,0.25)_50%] bg-size-[100%_4px]"
        >
        </div>
        <div class="relative z-10">
          <span id="terminal-text" data-source={terminalBoot} aria-live="polite"
          ></span>
          <span
            class="term-cursor ml-1 inline-block h-5 w-2.5 align-middle bg-emerald-500 shadow-[0_0_8px_var(--color-emerald-500)]"
          ></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const target = document.getElementById("terminal-text");
  const source = target?.dataset.source ?? "";
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (target) {
    if (reduced) {
      target.textContent = source;
    } else {
      let index = 0;
      const timer = window.setInterval(() => {
        if (index < source.length) {
          target.textContent = source.substring(0, index + 1);
          index += 1;
        } else {
          window.clearInterval(timer);
        }
      }, 25);
    }
  }
</script>
